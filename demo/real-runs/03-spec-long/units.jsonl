{"candidate_topics":["reliability","definitions"],"canonical_statement":"Within a single annotation scheme, per-category reliability varies by a factor of two and the abstract categories are systematically worst: CoreSC measured Conclusion at 0.89 and Method at 0.74, against Hypothesis 0.46, Motivation 0.46 and Model 0.43. Any category that cannot be written as a surface test should be expected to land near 0.45 regardless of codebook quality.","content_sha256":"fe5d0160f4e3a712b46925d4d504e17e86062175b58ea6f822e947534234a4bf","context_note":"The verified finding that governs how every definition in the document is written, and the reason surface cues are preferred to judgments throughout.","created_at":"2026-08-12T11:46:52.192544+00:00","decision":"keep","decontextualization_note":"","drop_reason":null,"entity_mentions":[],"evidence":[{"excerpt":"CoreSC measured `Conclusion` 0.89, `Background` 0.87, `Object` 0.81,\n`Observation` 0.79, `Result` 0.78, `Method` 0.74 — against `Hypothesis` 0.46,\n`Motivation` 0.46, `Model` 0.43.","excerpt_sha256":"80489098340d12883839f3d61174e5df11cbb1dfda01dbb71219879efa0132f3","excerpt_verified":true,"normalized_char_end":5922,"normalized_char_start":5743,"normalized_line_end":135,"normalized_line_start":133,"normalized_path":"01_normalized/src-specification-bf9781a3/normalized.txt","original_locator_end":{},"original_locator_start":{},"role":"primary","source_id":"src-specification-bf9781a3"}],"extraction_confidence":0.9,"flags":[],"granularity_policy":"molecular-v1","grounding":"attributable","independence_group":"group-src-specification-bf9781a3","modality":null,"model_role":"molecular-extractor","node_kind":"unit","parent_artifacts":["01_normalized/src-specification-bf9781a3/normalized.txt"],"prompt_version":"pass-01-molecular-extraction-v4.2","qualifiers":[],"quantitative":true,"run_id":"spec","schema_version":"3.1.0","scores":{"connection_value":3,"evidence_strength":3,"novelty":3,"retrieval_value":3,"specificity":3},"source_fa