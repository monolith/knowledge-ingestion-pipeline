{"candidate_topics":["evidence","methodology"],"canonical_statement":"The specification labels every claim by its evidential status: VERIFIED means it survived three-vote adversarial verification against a named primary source, MEASURED means it comes from the in-house runs that measured this codebook rather than a published one, and DESIGN means an engineering decision with no supporting measurement.","content_sha256":"1aeeda5e8fd5b58ac7d3379e6a9aa42b682a6902f19bc0b2b4c6bad88ef6f8c1","context_note":"The document's own epistemic convention, which is what lets a reader tell its evidence from its opinions.","created_at":"2026-08-12T11:46:52.190739+00:00","decision":"keep","decontextualization_note":"","drop_reason":null,"entity_mentions":[],"evidence":[{"excerpt":"**Evidence convention.** Every claim marked `[VERIFIED]` survived three-vote\nadversarial verification against a primary source","excerpt_sha256":"662525770f2423241cced6d7395d4dfb7f63fec54de1daa058134b3afb2083ef","excerpt_verified":true,"normalized_char_end":984,"normalized_char_start":858,"normalized_line_end":24,"normalized_line_start":23,"normalized_path":"01_normalized/src-specification-bf9781a3/normalized.txt","original_locator_end":{},"original_locator_start":{},"role":"primary","source_id":"src-specification-bf9781a3"}],"extraction_confidence":0.9,"flags":[],"granularity_policy":"molecular-v1","grounding":"attributable","independence_group":"group-src-specification-bf9781a3","modality":null,"model_role":"molecular-extractor","node_kind":"unit","parent_artifacts":["01_normalized/src-specification-bf9781a3/normalized.txt"],"prompt_version":"pass-01-molecular-extraction-v4.2","qualifiers":[],"quantitative":false,"run_id":"spec","schema_version":"3.1.0","scores":{"connection_value":3,"evidence_strength":3,"novelty":3,"retrieval_value":3,"specificity":3},"source_family_id":"family-src-specification-bf9781a3","source_id":"src-specification-bf9781a3","suppressed_modality":null,"unit_id":"u-src-specification-