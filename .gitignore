__pycache__/
*.py[cod]
# setuptools scratch. `pip wheel .` leaves a full copy of src/kip here, which
# was committed by accident once -- a duplicate source tree in the repo is worse
# than clutter, because a reader cannot tell which copy is the real one.
build/
dist/
.pytest_cache/
*.egg-info/
.kip/
# Run output from local workspaces. The demo runs are checked in deliberately:
# they are the repo's worked examples, so the directory itself must be
# re-included before its contents can be tracked.
runs/
!demo/real-runs/*/runs/
.venv/
demo/__pycache__/
